/**app.wxss**/
page {
  background-color: #fff5f8;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  color: #333;
  font-size: 28rpx;
  box-sizing: border-box;
}

view, text, button, input, textarea, scroll-view, swiper, swiper-item {
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
  min-height: 100vh;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 111, 157, 0.08);
  margin-bottom: 24rpx;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.title-row .title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.title-row .more {
  font-size: 24rpx;
  color: #ff6f9d;
}

.amount {
  color: #ff6f9d;
  font-weight: 600;
}

.muted {
  color: #999;
  font-size: 24rpx;
}

.primary-btn {
  background: linear-gradient(135deg, #ff6f9d, #ff9ec0);
  color: #fff;
  border-radius: 48rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}

.ghost-btn {
  background: #fff;
  color: #ff6f9d;
  border: 2rpx solid #ff6f9d;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
}

.empty {
  text-align: center;
  color: #bbb;
  padding: 80rpx 0;
  font-size: 26rpx;
}