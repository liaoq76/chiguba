<!-- pages/vocab/vocab.wxml — 个人词库（紫色 Hero V2） -->
<view class="vocab-page">

  <!-- === 紫色渐变 Hero === -->
  <view class="vocab-hero">
    <view class="vocab-hero__bg vocab-hero__bg--1"></view>
    <view class="vocab-hero__bg vocab-hero__bg--2"></view>
    <view class="vocab-hero__seal">{{categoryEmoji}}</view>
    <view class="vocab-hero__title">个人词库</view>
    <view class="vocab-hero__subtitle">统一管理 IP / 游戏 / 角色 / 类型 / 渠道</view>
    <view class="vocab-hero__stats">
      <view class="vocab-hero__stat">
        <text class="vocab-hero__stat-val">{{items.length}}</text>
        <text class="vocab-hero__stat-label">{{categoryLabel}}词条</text>
      </view>
      <view class="vocab-hero__divider"></view>
      <view class="vocab-hero__stat">
        <text class="vocab-hero__stat-val">5</text>
        <text class="vocab-hero__stat-label">分类</text>
      </view>
    </view>
  </view>

  <!-- === 分类 Tabs === -->
  <view class="vocab-tabs">
    <view wx:for="{{categoryList}}" wx:key="key"
          class="vocab-tabs__item {{activeType === item.key ? 'vocab-tabs__item--active' : ''}}"
          data-t="{{item.key}}"
          bindtap="switchType">
      <text class="vocab-tabs__emoji">{{item.emoji}}</text>
      <text class="vocab-tabs__label">{{item.label}}</text>
    </view>
  </view>

  <!-- === 词条列表 === -->
  <view class="vocab-list">
    <view wx:if="{{items.length === 0}}" class="vocab-empty">
      <view class="vocab-empty__seal">📚</view>
      <view class="vocab-empty__text">该分类下还没有词条</view>
      <view class="vocab-empty__btn" bindtap="addWord">+ 添加第一个</view>
    </view>

    <view wx:for="{{items}}" wx:key="_id" class="vocab-row">
      <view class="vocab-row__dot vocab-row__dot--{{activeType}}"></view>
      <text class="vocab-row__name">{{item.name}}</text>
      <view class="vocab-row__actions">
        <view class="vocab-row__btn vocab-row__btn--edit" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="rename">修改</view>
        <view class="vocab-row__btn vocab-row__btn--danger" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="remove">删除</view>
      </view>
    </view>
  </view>

  <!-- === 底部操作区 === -->
  <view class="vocab-action">
    <view class="vocab-action__add" bindtap="addWord">+ 添加{{categoryLabel}}</view>
    <view class="vocab-action__clear" bindtap="clearAll">清空词库</view>
  </view>
</view>
