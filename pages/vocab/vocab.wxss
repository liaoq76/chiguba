/* pages/vocab/vocab.wxss */
.vocab-page { padding-bottom: 80rpx; }
.tabs {
  display: flex;
  margin: 16rpx 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 6rpx;
}
.tabs__item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 22rpx;
  color: var(--text-sub);
  border-radius: 8rpx;
}
.tabs__item--active {
  background: var(--primary-soft);
  color: var(--primary);
}
.vocab-list {
  margin: 0 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
}
.vocab-row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.vocab-row:last-child { border-bottom: 0; }
.vocab-row__name { flex: 1; font-size: 28rpx; color: var(--text); }
.vocab-row__btn {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  margin-left: 12rpx;
  border-radius: 6rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--line);
  color: var(--text-sub);
}
.vocab-row__btn--danger {
  color: var(--danger);
  border-color: var(--danger);
}
.action-bar {
  text-align: center;
  padding: 32rpx;
}
