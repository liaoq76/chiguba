/* pages/stats/records.wxss — V2 樱花粉 UI */
.rec-page { padding-bottom: 200rpx; padding-top: 16rpx; }
.condition-bar {
  padding: 16rpx 24rpx;
  margin: 0 28rpx 20rpx;
  border-radius: 999rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}
.cond-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, var(--primary-soft) 0%, var(--secondary-soft) 100%);
  color: var(--primary);
  font-size: 22rpx;
  border-radius: 999rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 148, 185, 0.2);
}
.cond-tag__close {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}

.record-list {
  margin: 0 28rpx;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 8rpx 0;
}
.record {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.record:last-child { border-bottom: 0; }
.record:active { background: rgba(255, 255, 255, 0.5); }
.record__icon {
  width: 72rpx; height: 72rpx;
  border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
  background: linear-gradient(135deg, var(--primary-soft) 0%, #FFE0EC 100%);
  color: var(--primary);
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(255, 148, 185, 0.15);
}
.record__icon--game {
  background: linear-gradient(135deg, var(--secondary-soft) 0%, #E5DEFF 100%);
  color: var(--secondary);
  box-shadow: 0 2rpx 8rpx rgba(155, 139, 255, 0.15);
}
.record__main { flex: 1; min-width: 0; }
.record__name { font-size: 28rpx; color: var(--text); font-weight: 500; }
.record__sub { font-size: 22rpx; color: var(--text-mute); margin-top: 4rpx; }
.record__amount {
  font-size: 28rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  text-align: right;
}
.record__date { font-size: 22rpx; text-align: right; margin-top: 4rpx; }
