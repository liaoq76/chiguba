/* pages/stats/records.wxss */
.rec-page { padding-bottom: 60rpx; }
.condition-bar {
  padding: 16rpx 32rpx;
  background: var(--bg-card);
  margin: 16rpx 28rpx;
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.cond-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 22rpx;
  border-radius: 6rpx;
}
.cond-tag__close {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--primary);
}
.record-list {
  margin: 0 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  overflow: hidden;
}
.record {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.record:last-child { border-bottom: 0; }
.record__icon {
  width: 64rpx; height: 64rpx;
  border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
  background: var(--primary-soft);
  color: var(--primary);
}
.record__icon--game {
  background: var(--accent-soft);
  color: var(--accent);
}
.record__main { flex: 1; }
.record__name { font-size: 26rpx; color: var(--text); }
.record__sub { font-size: 22rpx; color: var(--text-mute); margin-top: 4rpx; }
.record__amount { font-size: 26rpx; color: var(--text); font-variant-numeric: tabular-nums; font-weight: 500; }
