<view class="stats-page">

  <!-- 时间范围 -->
  <view class="range-tabs float-card">
    <view class="range-tabs__item {{rangeType === 'week' ? 'range-tabs__item--active' : ''}}" data-t="week" bindtap="switchRange">本周</view>
    <view class="range-tabs__item {{rangeType === 'month' ? 'range-tabs__item--active' : ''}}" data-t="month" bindtap="switchRange">本月</view>
    <view class="range-tabs__item {{rangeType === 'year' ? 'range-tabs__item--active' : ''}}" data-t="year" bindtap="switchRange">本年</view>
  </view>

  <view class="range-label">{{rangeLabel}}</view>

  <!-- 总览 - 渐变 hero -->
  <view class="overview-card gradient-hero">
    <view class="overview-card__head">
      <text class="overview-card__label">📊 消费总览</text>
    </view>
    <view class="overview-card__total gradient-text-light t-money">{{total}}</view>
    <view class="overview-card__count">共 {{count}} 笔</view>
    <view class="overview-card__breakdown">
      <view class="overview-card__item">
        <text class="overview-card__icon">🛍</text>
        <text class="overview-card__name">谷子</text>
        <text class="overview-card__amount t-money">{{guzi}}</text>
      </view>
      <view class="overview-card__divider"></view>
      <view class="overview-card__item">
        <text class="overview-card__icon">🎮</text>
        <text class="overview-card__name">游戏</text>
        <text class="overview-card__amount t-money">{{game}}</text>
      </view>
    </view>
  </view>

  <!-- 趋势 -->
  <view class="card float-card">
    <view class="card-title">
      <view class="card-title__left">
        <view class="card-title__dot"></view>
        <text>趋势</text>
      </view>
    </view>
    <view class="trend-switch">
      <view class="trend-switch__btn {{trendMode === 'cumulative' ? 'trend-switch__btn--active' : ''}}" data-m="cumulative" bindtap="switchTrend">累计</view>
      <view class="trend-switch__btn {{trendMode === 'actual' ? 'trend-switch__btn--active' : ''}}" data-m="actual" bindtap="switchTrend">实际</view>
    </view>
    <view class="trend-chart">
      <canvas canvas-id="statsTrend" id="statsTrend" type="2d" bindtouchstart="onTrendTouch" class="trend-chart__canvas"></canvas>
    </view>
  </view>

  <!-- 消费构成（环形图） -->
  <view class="card float-card">
    <view class="card-title">
      <view class="card-title__left">
        <view class="card-title__dot"></view>
        <text>消费构成</text>
      </view>
    </view>
    <view class="ring-row">
      <canvas canvas-id="statsRing" id="statsRing" type="2d" class="ring-canvas"></canvas>
      <view class="ring-legend">
        <view class="ring-legend__item">
          <view class="ring-legend__name">
            <view class="ring-legend__dot ring-legend__dot--guzi"></view>
            <text>🛍 谷子</text>
          </view>
          <text class="ring-legend__amount t-money">{{guzi}}</text>
        </view>
        <view class="ring-legend__item">
          <view class="ring-legend__name">
            <view class="ring-legend__dot ring-legend__dot--game"></view>
            <text>🎮 游戏</text>
          </view>
          <text class="ring-legend__amount t-money">{{game}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- IP Top5 -->
  <view class="card float-card">
    <view class="card-title">
      <view class="card-title__left">
        <view class="card-title__dot"></view>
        <text>IP 消费 Top 5</text>
      </view>
    </view>
    <view wx:if="{{ipTop.length === 0 && !ipBlank}}" class="empty">
      <view class="empty__text">没有 IP 数据</view>
    </view>

    <block wx:for="{{ipTop}}" wx:key="key">
      <view class="ip-row" data-name="{{item.name}}" bindtap="expandIp">
        <text class="ip-row__name">{{item.name}}</text>
        <view class="ip-row__bar-wrap">
          <view class="ip-row__bar" style="width: {{item.percent}}"></view>
        </view>
        <text class="ip-row__amount t-money">{{item.amount}}</text>
        <text class="ip-row__arrow">{{expandedIp === item.name ? '▲' : '▼'}}</text>
      </view>
      <view wx:if="{{expandedIp === item.name}}" class="ip-detail float-card">
        <view class="ip-detail__item">
          <text class="ip-detail__label">占比</text>
          <text class="ip-detail__value">{{item.percent}}</text>
        </view>
        <view class="ip-detail__item">
          <text class="ip-detail__label">笔数</text>
          <text class="ip-detail__value">{{item.count}}</text>
        </view>
        <view class="ip-detail__item">
          <text class="ip-detail__label">谷子</text>
          <text class="ip-detail__value t-money">¥{{item.guzi}}</text>
        </view>
        <view class="ip-detail__item">
          <text class="ip-detail__label">游戏</text>
          <text class="ip-detail__value t-money">¥{{item.game}}</text>
        </view>
        <view class="ip-detail__link">
          <text class="t-primary" data-name="{{item.name}}" bindtap="goIpDetail">查看 IP 详情 ›</text>
        </view>
      </view>
    </block>

    <view wx:if="{{ipOther}}" class="ip-row" data-name="__OTHERS__" bindtap="expandIp">
      <text class="ip-row__name">其他 <text class="t-mute" style="font-size:22rpx;">· {{ipOther.restCount}} 个 IP</text></text>
      <view class="ip-row__bar-wrap">
        <view class="ip-row__bar ip-row__bar--other" style="width: {{ipOther.percent}}"></view>
      </view>
      <text class="ip-row__amount t-money">{{ipOther.amount}}</text>
      <text class="ip-row__arrow">{{expandedIp === '__OTHERS__' ? '▲' : '▼'}}</text>
    </view>
    <view wx:if="{{expandedIp === '__OTHERS__' && ipOther}}" class="ip-detail float-card">
      <view wx:for="{{ipOther.restList}}" wx:key="key" class="ip-row" style="padding:8rpx 0;">
        <text class="ip-row__name t-small">{{item.name}}</text>
        <view class="ip-row__bar-wrap"><view class="ip-row__bar ip-row__bar--other" style="width: {{item.percent}}"></view></view>
        <text class="ip-row__amount t-small t-money">¥{{item.total}}</text>
      </view>
    </view>

    <view wx:if="{{ipBlank}}" class="ip-row" data-name="__BLANK__" bindtap="expandIp">
      <text class="ip-row__name t-mute">未填写IP</text>
      <view class="ip-row__bar-wrap">
        <view class="ip-row__bar ip-row__bar--blank" style="width: {{ipBlank.percent}}"></view>
      </view>
      <text class="ip-row__amount t-money">{{ipBlank.amount}}</text>
      <text class="ip-row__arrow">{{expandedIp === '__BLANK__' ? '▲' : '▼'}}</text>
    </view>
  </view>
</view>
