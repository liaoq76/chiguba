/* pages/stats/stats.wxss — V2 樱花粉 UI */
.stats-page { padding-bottom: 200rpx; padding-top: 16rpx; }

.range-tabs {
  display: flex;
  margin: 0 28rpx 16rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.range-tabs__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 999rpx;
  font-weight: 500;
  transition: all 0.25s ease;
}
.range-tabs__item--active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx var(--shadow-primary);
  font-weight: 600;
}

.range-label {
  padding: 12rpx 32rpx 8rpx;
  font-size: 24rpx;
  color: var(--text-mute);
  font-weight: 500;
}

/* 总览 hero */
.overview-card {
  margin: 0 28rpx 20rpx;
  padding: 32rpx 32rpx 28rpx;
  border-radius: 28rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 40rpx rgba(155, 139, 255, 0.35);
}
.overview-card__head {
  position: relative;
  z-index: 2;
}
.overview-card__label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  font-weight: 500;
  letter-spacing: 1rpx;
}
.overview-card__total {
  font-size: 72rpx;
  color: #fff;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.15;
  letter-spacing: 1rpx;
  margin: 12rpx 0 4rpx;
  position: relative;
  z-index: 2;
}
.overview-card__count {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  position: relative;
  z-index: 2;
}
.overview-card__breakdown {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  position: relative;
  z-index: 2;
}
.overview-card__item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #fff;
}
.overview-card__icon { font-size: 24rpx; }
.overview-card__name { font-size: 24rpx; flex: 1; }
.overview-card__amount {
  font-variant-numeric: tabular-nums;
  color: #fff;
  font-weight: 600;
  font-size: 28rpx;
}
.overview-card__divider {
  width: 1rpx;
  height: 40rpx;
  background: rgba(255, 255, 255, 0.3);
}
.gradient-text-light {
  background: linear-gradient(135deg, #FFFFFF 0%, #FFE0EC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.card {
  margin: 0 28rpx 20rpx;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}
.card-title {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 16rpx;
}
.card-title__dot {
  width: 8rpx; height: 28rpx;
  background: linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 4rpx;
}
.card-title__name { font-size: 28rpx; color: var(--text); font-weight: 600; }

.trend-switch {
  display: flex;
  gap: 8rpx;
  margin-bottom: 16rpx;
  background: var(--line-soft);
  padding: 4rpx;
  border-radius: 999rpx;
  align-self: flex-start;
  width: fit-content;
}
.trend-switch__btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  border-radius: 999rpx;
  background: transparent;
  color: var(--text-sub);
  font-weight: 500;
}
.trend-switch__btn--active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  color: #fff;
  box-shadow: 0 2rpx 8rpx var(--shadow-primary);
  font-weight: 600;
}
.trend-chart { height: 300rpx; }
.trend-chart__canvas { width: 100%; height: 100%; }

.ring-row { display: flex; align-items: center; gap: 24rpx; }
.ring-canvas { width: 240rpx; height: 240rpx; flex-shrink: 0; }
.ring-legend { flex: 1; }
.ring-legend__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.ring-legend__item:last-child { border-bottom: 0; }
.ring-legend__name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}
.ring-legend__dot {
  width: 18rpx; height: 18rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.ring-legend__dot--guzi { background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%); }
.ring-legend__dot--game { background: linear-gradient(135deg, var(--secondary) 0%, #7B6BFF 100%); }
.ring-legend__amount {
  font-size: 28rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}

.ip-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.ip-row:last-child { border-bottom: 0; }
.ip-row__name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}
.ip-row__bar-wrap {
  width: 35%;
  height: 16rpx;
  background: var(--line-soft);
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.ip-row__bar {
  height: 100%;
  background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 8rpx;
}
.ip-row__bar--blank { background: var(--text-mute); }
.ip-row__bar--other { background: var(--accent); }
.ip-row__amount {
  font-size: 26rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  width: 160rpx;
  text-align: right;
}

.ip-detail {
  padding: 16rpx 20rpx;
  margin: 8rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
}
.ip-detail__item {
  width: calc(50% - 8rpx);
  display: flex;
  justify-content: space-between;
}
.ip-detail__label { color: var(--text-mute); }
.ip-detail__value { color: var(--text); font-variant-numeric: tabular-nums; font-weight: 500; }
.ip-detail__link {
  width: 100%;
  text-align: right;
  padding-top: 8rpx;
  font-size: 24rpx;
}

.ip-row__arrow {
  font-size: 28rpx;
  color: var(--text-mute);
  margin-left: 12rpx;
  font-weight: 300;
}
