/* pages/stats/stats.wxss */
.stats-page { padding-bottom: 80rpx; }

.range-tabs {
  display: flex;
  margin: 16rpx 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 6rpx;
}
.range-tabs__item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--text-sub);
  border-radius: 8rpx;
}
.range-tabs__item--active {
  background: var(--primary-soft);
  color: var(--primary);
}

.range-label {
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--text-mute);
}

.card {
  background: var(--bg-card);
  margin: 0 28rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  padding: 28rpx 32rpx;
}
.card-title {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 16rpx;
}
.card-title__dot {
  width: 8rpx; height: 24rpx;
  background: var(--primary);
  border-radius: 2rpx;
}
.card-title__name { font-size: 28rpx; color: var(--text); font-weight: 500; }

.overview {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.overview__total {
  font-size: 56rpx;
  color: var(--primary);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.overview__count { font-size: 22rpx; color: var(--text-mute); }

.trend-switch {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.trend-switch__btn {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  border-radius: 6rpx;
  background: var(--bg-elev);
  color: var(--text-sub);
  border: 1rpx solid var(--line);
}
.trend-switch__btn--active {
  background: var(--primary);
  color: #fff;
  border-color: var(--primary);
}
.trend-chart { height: 280rpx; }

.ring-row { display: flex; align-items: center; gap: 24rpx; }
.ring-canvas { width: 240rpx; height: 240rpx; flex-shrink: 0; }
.ring-legend { flex: 1; }
.ring-legend__item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.ring-legend__item:last-child { border-bottom: 0; }
.ring-legend__name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: var(--text);
}
.ring-legend__dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
}
.ring-legend__dot--guzi { background: var(--primary); }
.ring-legend__dot--game { background: var(--accent); }
.ring-legend__amount {
  font-size: 26rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
}

.ip-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.ip-row:last-child { border-bottom: 0; }
.ip-row__name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text);
}
.ip-row__bar-wrap {
  width: 50%;
  height: 16rpx;
  background: var(--line-soft);
  border-radius: 8rpx;
  margin: 0 16rpx;
  overflow: hidden;
}
.ip-row__bar {
  height: 100%;
  background: var(--primary);
  border-radius: 8rpx;
}
.ip-row__bar--blank { background: var(--text-mute); }
.ip-row__bar--other { background: var(--gold); }
.ip-row__amount {
  font-size: 26rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  width: 160rpx;
  text-align: right;
}

.ip-detail {
  padding: 16rpx 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  font-size: 22rpx;
  color: var(--text-sub);
}
.ip-detail__item {
  width: calc(50% - 8rpx);
  display: flex;
  justify-content: space-between;
}
.ip-detail__label { color: var(--text-mute); }
.ip-detail__value { color: var(--text); font-variant-numeric: tabular-nums; }

.ip-row__arrow {
  font-size: 28rpx;
  color: var(--text-mute);
  margin-left: 12rpx;
}
