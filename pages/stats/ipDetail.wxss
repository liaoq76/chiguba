/* pages/stats/ipDetail.wxss */
.ip-detail-page { padding-bottom: 80rpx; }
.ip-hero {
  background: var(--bg-card);
  margin: 24rpx 28rpx;
  padding: 32rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  text-align: center;
}
.ip-hero__name {
  font-size: 32rpx;
  color: var(--text);
  margin-bottom: 16rpx;
}
.ip-hero__total {
  font-size: 64rpx;
  color: var(--primary);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}
.ip-hero__breakdown {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line-soft);
  font-size: 24rpx;
  color: var(--text-sub);
}
.card {
  background: var(--bg-card);
  margin: 0 28rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  padding: 28rpx 32rpx;
}
.card-title {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 16rpx;
}
.card-title__dot {
  width: 8rpx; height: 24rpx;
  background: var(--primary);
  border-radius: 2rpx;
}
.card-title__name { font-size: 28rpx; color: var(--text); font-weight: 500; }
.dim-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
  font-size: 26rpx;
}
.dim-row:last-child { border-bottom: 0; }
.dim-row__name { color: var(--text); }
.dim-row__count { color: var(--text-mute); margin-right: 16rpx; font-size: 22rpx; }
.dim-row__amount { color: var(--text); font-variant-numeric: tabular-nums; }

.range-tabs {
  display: flex;
  margin: 16rpx 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 6rpx;
}
.range-tabs__item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--text-sub);
  border-radius: 8rpx;
}
.range-tabs__item--active {
  background: var(--primary-soft);
  color: var(--primary);
}
.range-label {
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: var(--text-mute);
}
