/* pages/stats/ipDetail.wxss — V2 樱花粉 UI */
.ip-detail-page { padding-bottom: 200rpx; padding-top: 16rpx; }

.range-tabs {
  display: flex;
  margin: 0 28rpx 16rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.range-tabs__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 999rpx;
  font-weight: 500;
  transition: all 0.25s ease;
}
.range-tabs__item--active {
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx var(--shadow-primary);
  font-weight: 600;
}
.range-label {
  padding: 12rpx 32rpx 8rpx;
  font-size: 24rpx;
  color: var(--text-mute);
  font-weight: 500;
}

.ip-hero {
  margin: 0 28rpx 20rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(155, 139, 255, 0.35);
}
.ip-hero__name {
  font-size: 36rpx;
  color: #fff;
  margin-bottom: 12rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 2;
}
.ip-hero__total {
  font-size: 72rpx;
  color: #fff;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
  position: relative;
  z-index: 2;
}
.ip-hero__breakdown {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  font-size: 24rpx;
  color: #fff;
  position: relative;
  z-index: 2;
}
.ip-hero__chip {
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-weight: 500;
}

.card {
  margin: 0 28rpx 20rpx;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
}
.card-title {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 16rpx;
}
.card-title__dot {
  width: 8rpx; height: 28rpx;
  background: linear-gradient(180deg, var(--primary) 0%, var(--secondary) 100%);
  border-radius: 4rpx;
}
.card-title__name { font-size: 28rpx; color: var(--text); font-weight: 600; }
.dim-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
  font-size: 26rpx;
}
.dim-row:last-child { border-bottom: 0; }
.dim-row__name { color: var(--text); font-weight: 500; }
.dim-row__count {
  color: var(--text-mute);
  margin-right: 16rpx;
  font-size: 22rpx;
  background: var(--line-soft);
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}
.dim-row__amount {
  color: var(--text);
  font-variant-numeric: tabular-nums;
  font-weight: 700;
}
.empty-cell {
  padding: 32rpx;
  text-align: center;
  color: var(--text-mute);
  font-size: 24rpx;
}
