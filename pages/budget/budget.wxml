<!-- pages/budget/budget.wxml — 预算管理（浅粉紫 Hero + SVG 环形图） -->
<view class="budget-page">

  <!-- === 浅粉紫渐变 Hero（柔和高明度） === -->
  <view class="budget-hero">
    <view class="budget-hero__bg budget-hero__bg--1"></view>
    <view class="budget-hero__bg budget-hero__bg--2"></view>

    <view class="budget-hero__top">
      <view class="budget-hero__title-block">
        <view class="budget-hero__title">预算管理</view>
        <view class="budget-hero__subtitle">10 月 · 实时追踪支出进度</view>
      </view>
      <view class="budget-hero__icon">💰</view>
    </view>

    <!-- === SVG 环形图（一次性渲染，绝对可见） === -->
    <view class="budget-ring">
      <view class="budget-ring__svg-wrap">
        <svg class="budget-ring__svg" viewBox="0 0 120 120">
          <defs>
            <linearGradient id="ringGrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#FFB3D9"/>
              <stop offset="50%" stop-color="#E0BBE4"/>
              <stop offset="100%" stop-color="#C4A0F5"/>
            </linearGradient>
          </defs>
          <!-- 背景环 -->
          <circle cx="60" cy="60" r="48" stroke="rgba(255,255,255,0.4)" stroke-width="14" fill="none"/>
          <!-- 进度环：用 stroke-dasharray + stroke-dashoffset 精确控制 -->
          <circle cx="60" cy="60" r="48"
                  stroke="url(#ringGrad)"
                  stroke-width="14"
                  fill="none"
                  stroke-linecap="round"
                  stroke-dasharray="{{301.59}}"
                  stroke-dashoffset="{{strokeOffset}}"
                  transform="rotate(-90 60 60)"/>
        </svg>
      </view>
      <view class="budget-ring__center">
        <view class="budget-ring__percent">{{totalPercent}}<text class="budget-ring__pct">%</text></view>
        <view class="budget-ring__amount">¥{{totalActual}}</view>
      </view>
    </view>

    <!-- === 顶部统计 === -->
    <view class="budget-hero__stats">
      <view class="budget-hero__stat">
        <text class="budget-hero__stat-label">总预算</text>
        <text class="budget-hero__stat-val">¥{{totalBudget}}</text>
      </view>
      <view class="budget-hero__divider"></view>
      <view class="budget-hero__stat">
        <text class="budget-hero__stat-label">已支出</text>
        <text class="budget-hero__stat-val">¥{{totalActual}}</text>
      </view>
      <view class="budget-hero__divider"></view>
      <view class="budget-hero__stat">
        <text class="budget-hero__stat-label">剩余</text>
        <text class="budget-hero__stat-val">¥{{totalBudget - totalActual}}</text>
      </view>
    </view>
  </view>

  <!-- === 分类预算 === -->
  <view class="budget-section-title">分类预算</view>

  <!-- 谷子 -->
  <view class="budget-card">
    <view class="budget-card__row">
      <view class="budget-card__icon budget-card__icon--pink">🛍</view>
      <view class="budget-card__main">
        <view class="budget-card__name">谷子 / 周边</view>
        <view class="budget-card__bar">
          <view class="budget-card__fill" style="width: {{guziPercent}}%"></view>
        </view>
        <view class="budget-card__meta">
          <text class="budget-card__amount">¥{{guziActual}} <text class="budget-card__divider">/ ¥{{guziBudget}}</text></text>
          <text class="budget-card__badge budget-card__badge--safe">{{guziPercent}}%</text>
        </view>
      </view>
    </view>
    <view class="budget-card__actions">
      <view class="budget-card__btn budget-card__btn--ghost" data-type="guzi" bindtap="openBudget">修改</view>
      <view class="budget-card__btn budget-card__btn--primary" data-type="guzi" bindtap="openBudget">调整</view>
    </view>
  </view>

  <!-- 游戏 -->
  <view class="budget-card">
    <view class="budget-card__row">
      <view class="budget-card__icon budget-card__icon--lavender">🎮</view>
      <view class="budget-card__main">
        <view class="budget-card__name">游戏氪金</view>
        <view class="budget-card__bar">
          <view class="budget-card__fill budget-card__fill--warn" style="width: {{gamePercent}}%"></view>
        </view>
        <view class="budget-card__meta">
          <text class="budget-card__amount">¥{{gameActual}} <text class="budget-card__divider">/ ¥{{gameBudget}}</text></text>
          <text class="budget-card__badge budget-card__badge--warn">{{gamePercent}}%</text>
        </view>
      </view>
    </view>
    <view class="budget-card__actions">
      <view class="budget-card__btn budget-card__btn--ghost" data-type="game" bindtap="openBudget">修改</view>
      <view class="budget-card__btn budget-card__btn--primary" data-type="game" bindtap="openBudget">调整</view>
    </view>
  </view>

  <!-- 添加分类 -->
  <view class="budget-add" bindtap="openBudget" data-type="add">
    <view class="budget-add__plus">+</view>
    <text class="budget-add__text">添加分类预算</text>
  </view>

  <!-- === 历史周期 === -->
  <view class="budget-section-title" wx:if="{{history.length > 0}}">历史周期</view>
  <view wx:if="{{history.length > 0}}" class="budget-card budget-card--history">
    <view wx:for="{{history}}" wx:key="_id" class="budget-history">
      <view class="budget-history__label">
        <view class="budget-history__dot"></view>
        <text>{{item.label}}</text>
      </view>
      <view class="budget-history__amounts">
        <text class="budget-history__actual">¥{{item.actual}}</text>
        <text class="budget-history__total">/ ¥{{item.amount}}</text>
      </view>
    </view>
  </view>
</view>
