.hello {
  font-size: 30rpx;
  color: #333;
  margin: 8rpx 0 20rpx;
}

.banner {
  background: linear-gradient(135deg, #ffd1e1, #ffe7f0);
  border: none;
  color: #5a2c3d;
}

.banner-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.big-amount {
  font-size: 60rpx;
  font-weight: 700;
  color: #c93a76;
  margin-top: 8rpx;
}

.banner-side {
  text-align: right;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.budget-bar {
  width: 100%;
  height: 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.6);
  overflow: hidden;
  margin-bottom: 8rpx;
}

.budget-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6f9d, #ff9ec0);
  border-radius: 8rpx;
}

.budget-tip {
  margin-bottom: 20rpx;
  color: #8a4a64;
}

.actions {
  display: flex;
  gap: 16rpx;
}

.actions .primary-btn,
.actions .ghost-btn {
  flex: 1;
}

.top-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.top-item {
  flex: 1 0 30%;
  min-width: 30%;
  background: #fff7fb;
  border-radius: 16rpx;
  padding: 20rpx;
  text-align: center;
}

.top-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.top-name {
  font-size: 24rpx;
  color: #555;
}

.top-amount {
  font-size: 28rpx;
  margin-top: 6rpx;
}

.record-list {
  padding: 8rpx 0;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f5e6ec;
}

.record-row:last-child {
  border-bottom: none;
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-sub {
  margin-top: 6rpx;
}

.record-amount {
  font-size: 30rpx;
  margin-left: 12rpx;
  white-space: nowrap;
}