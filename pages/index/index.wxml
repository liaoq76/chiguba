<view class="container">
  <view class="hello">{{greeting}}</view>
  <view class="banner card">
    <view class="banner-row">
      <view>
        <view class="muted">本月花销</view>
        <view class="big-amount">¥ {{monthTotal}}</view>
      </view>
      <view class="banner-side">
        <view class="muted">今日 ¥ {{todayTotal}}</view>
        <view class="muted">{{monthCount}} 笔</view>
      </view>
    </view>
    <view class="budget-bar" wx:if="{{budget > 0}}">
      <view class="budget-fill" style="width: {{budgetPercent}}%"></view>
    </view>
    <view class="muted budget-tip" wx:if="{{budget > 0}}">已用 {{budgetPercent}}% · 预算 ¥ {{budget}}</view>
    <view class="actions">
      <view class="primary-btn" bindtap="goAdd">记一笔</view>
      <view class="ghost-btn" bindtap="goStats">查看统计</view>
    </view>
  </view>

  <view class="title-row">
    <view class="title">分类花销 TOP</view>
    <view class="more" bindtap="goRecords">全部 ›</view>
  </view>
  <view class="card top-grid">
    <view class="top-item" wx:for="{{topCategories}}" wx:key="id">
      <view class="top-icon" style="background: {{item.color}}22; color: {{item.color}}">{{item.icon}}</view>
      <view class="top-name">{{item.name}}</view>
      <view class="top-amount amount">¥ {{item.amount}}</view>
    </view>
    <view class="empty" wx:if="{{topCategories.length === 0}}">还没有记录哦，去记一笔吧～</view>
  </view>

  <view class="title-row">
    <view class="title">最近记录</view>
    <view class="more" bindtap="goRecords">账本 ›</view>
  </view>
  <view class="card record-list">
    <view class="record-row" wx:for="{{recent}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="record-icon" style="background: {{item.categoryColor}}22; color: {{item.categoryColor}}">{{item.categoryIcon}}</view>
      <view class="record-main">
        <view class="record-title">{{item.title || item.categoryName}}</view>
        <view class="record-sub muted">{{item.dateLabel}} · {{item.categoryName}}</view>
      </view>
      <view class="record-amount amount">¥ {{item.amount}}</view>
    </view>
    <view class="empty" wx:if="{{recent.length === 0}}">还没有记录哦，去记一笔吧～</view>
  </view>
</view>