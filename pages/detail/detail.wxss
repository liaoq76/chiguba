.detail-card {
  background: linear-gradient(135deg, #ffd1e1, #ffe7f0);
  border: none;
  text-align: center;
}

.detail-amount {
  font-size: 72rpx;
  font-weight: 700;
  color: #c93a76;
}

.detail-title {
  font-size: 32rpx;
  color: #5a2c3d;
  margin-top: 12rpx;
}

.detail-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.cat-chip {
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5e6ec;
  font-size: 26rpx;
}

.info-row:last-child { border-bottom: none; }

.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-box {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-box image {
  width: 100%;
  height: 100%;
}

.danger-btn {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
  margin-top: 24rpx;
}