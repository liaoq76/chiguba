<view class="container" wx:if="{{record}}">
  <view class="card detail-card">
    <view class="detail-amount">¥ {{record.amount}}</view>
    <view class="detail-title">{{record.title || '未命名'}}</view>
    <view class="detail-meta">
      <view class="cat-chip" style="background: {{category.color}}22; color: {{category.color}}">
        {{category.icon}} {{category.name}}
      </view>
      <text class="muted">{{record.dateLabel || ''}}</text>
    </view>
  </view>

  <view class="card">
    <view class="title">记录信息</view>
    <view class="info-row"><text class="muted">时间</text><text>{{record.createdAt ? (record.createdAt - 0) : ''}}</text></view>
    <view class="info-row"><text class="muted">备注</text><text>{{record.note || '无'}}</text></view>
  </view>

  <view wx:if="{{images.length > 0}}" class="card">
    <view class="title">晒图</view>
    <view class="image-row">
      <view class="image-box" wx:for="{{images}}" wx:key="*this" data-src="{{item}}" bindtap="preview">
        <image src="{{item}}" mode="aspectFill" />
      </view>
    </view>
  </view>

  <view class="danger-btn" bindtap="remove">删除这条记录</view>
</view>