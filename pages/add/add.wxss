.add-page {
  padding-bottom: 60rpx;
}

.amount-card {
  background: linear-gradient(135deg, #ffd1e1, #ffe7f0);
  border: none;
  text-align: center;
}

.amount-input {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 12rpx;
}

.amount-symbol {
  font-size: 48rpx;
  color: #c93a76;
  margin-right: 12rpx;
}

.amount-input input {
  font-size: 64rpx;
  font-weight: 700;
  color: #c93a76;
  text-align: center;
  width: 60%;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-item {
  width: calc((100% - 32rpx) / 3);
  background: #fff7fb;
  border-radius: 16rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.cat-item.active {
  border-color: #ff6f9d;
  background: #ffe7f0;
}

.cat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-bottom: 8rpx;
}

.cat-name {
  font-size: 22rpx;
  color: #555;
}

.text-input,
.text-area {
  background: #f7f0f4;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  width: 100%;
}

.text-area {
  min-height: 120rpx;
  width: 100%;
}

.image-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-box {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-box image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  text-align: center;
  line-height: 34rpx;
  font-size: 28rpx;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #ff9ec0;
  color: #ff6f9d;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.save-btn {
  margin: 40rpx 0 0;
}