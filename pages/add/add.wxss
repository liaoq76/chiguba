/* pages/add/add.wxss — V3 极简高奢粉紫主题（复刻原型 luxury pink-purple） */

.add-page {
  padding: 0 0 60rpx;
  min-height: 100vh;
  position: relative;
  overflow: visible;
  background: radial-gradient(circle at 10% 20%, rgba(251, 207, 232, 0.7) 0%, rgba(243, 232, 255, 0.8) 45%, rgba(238, 242, 255, 0.9) 100%);
}

/* === 类型选择（第一步）— 沉浸式布局（自然流式） === */

/* 环境光晕：双层 ambient glow，模拟原型 8s/10s 呼吸动效 */
.ambient-glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(40px);
  pointer-events: none;
  z-index: 0;
  animation: pulse-glow 8s ease-in-out infinite alternate;
}
.ambient-glow--pink {
  top: 20%;
  left: 10%;
  width: 440rpx;
  height: 440rpx;
  background: radial-gradient(circle, rgba(244, 114, 182, 0.35) 0%, rgba(255, 255, 255, 0) 70%);
}
.ambient-glow--purple {
  bottom: 25%;
  right: 5%;
  width: 520rpx;
  height: 520rpx;
  background: radial-gradient(circle, rgba(168, 85, 247, 0.35) 0%, rgba(255, 255, 255, 0) 70%);
  animation-duration: 10s;
  animation-direction: alternate-reverse;
}
@keyframes pulse-glow {
  0% { transform: scale(0.9) translate(0, 0); opacity: 0.7; }
  100% { transform: scale(1.2) translate(20rpx, -30rpx); opacity: 1; }
}

.type-stage {
  position: relative;
  z-index: 10;
  width: 100%;
  /* 自然流式：内容从顶部往下排，不强制居中、不强制 min-height */
  padding: 140rpx 48rpx 200rpx;  /* 顶部让出 WeChat nav 栏，底部让出 tab-bar + 中央 + 按钮 */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 居中品牌徽标（脉冲圆点 + 标题） */
.type-stage__brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 48rpx;
}
.type-stage__brand-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d946ef;
  box-shadow: 0 0 16rpx rgba(217, 70, 239, 0.6);
  animation: pulse-dot 1.6s ease-in-out infinite;
}
@keyframes pulse-dot {
  0%, 100% { transform: scale(1); opacity: 0.85; }
  50% { transform: scale(1.3); opacity: 1; }
}
.type-stage__brand-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 2rpx;
}

.type-stage__head {
  text-align: center;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.type-stage__eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(217, 70, 239, 0.85);
  text-transform: uppercase;
  letter-spacing: 4rpx;
}
.type-stage__title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2937;
  letter-spacing: 1rpx;
}

/* === Luxury Card（双分类卡） === */
.luxury-card {
  position: relative;
  border-radius: 48rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 20rpx 40rpx -15rpx rgba(217, 70, 239, 0.12),
    0 8rpx 16rpx -8rpx rgba(139, 92, 246, 0.08);
  overflow: hidden;
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
              box-shadow 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.luxury-card--active {
  transform: scale(0.97);
  box-shadow:
    0 10rpx 20rpx -10rpx rgba(217, 70, 239, 0.2),
    0 4rpx 8rpx -4rpx rgba(139, 92, 246, 0.12);
}

/* 卡内 ambient shimmer 圆（角落呼吸光斑） */
.luxury-card__shimmer {
  position: absolute;
  right: -32rpx;
  top: -32rpx;
  width: 224rpx;
  height: 224rpx;
  border-radius: 50%;
  filter: blur(20rpx);
  transition: transform 0.5s ease;
  pointer-events: none;
}
.luxury-card__shimmer--pink {
  background: radial-gradient(circle, rgba(244, 114, 182, 0.4) 0%, rgba(255, 148, 200, 0.2) 50%, transparent 70%);
}
.luxury-card__shimmer--purple {
  background: radial-gradient(circle, rgba(168, 85, 247, 0.4) 0%, rgba(192, 132, 252, 0.2) 50%, transparent 70%);
}
.luxury-card--active .luxury-card__shimmer {
  transform: scale(1.25);
}

.luxury-card__row {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32rpx;
}

/* 图标方块（带渐变 + 阴影） */
.luxury-card__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
}
.luxury-card__icon--guzi {
  background: linear-gradient(135deg, #ec4899 0%, #fb7185 50%, #e879f9 100%);
  box-shadow: 0 12rpx 28rpx -4rpx rgba(236, 72, 153, 0.45);
}
.luxury-card__icon--game {
  background: linear-gradient(135deg, #9333ea 0%, #6366f1 50%, #d946ef 100%);
  box-shadow: 0 12rpx 28rpx -4rpx rgba(147, 51, 234, 0.45);
}
.luxury-card__icon-glyph {
  font-size: 44rpx;
  line-height: 1;
}

.luxury-card__main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.luxury-card__name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
  letter-spacing: 1rpx;
}
.luxury-card__desc {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 500;
  line-height: 1.4;
}

/* 右侧 chevron（hover 变色） */
.luxury-card__chevron {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
  flex-shrink: 0;
  transition: all 0.3s ease;
}
.luxury-card__chevron--guzi {
  background: rgba(236, 72, 153, 0.12);
  color: #db2777;
}
.luxury-card__chevron--game {
  background: rgba(168, 85, 247, 0.12);
  color: #9333ea;
}
.luxury-card--active .luxury-card__chevron--guzi {
  background: #ec4899;
  color: #fff;
}
.luxury-card--active .luxury-card__chevron--game {
  background: #9333ea;
  color: #fff;
}

/* === 表单（保持原 V2 样式） === */
.form-card {
  margin: 24rpx 28rpx 20rpx;
  border-radius: 24rpx;
  padding: 4rpx 32rpx;
  position: relative;
  z-index: 10;
}
.form-card .input-cell:last-child { border-bottom: 0; }

.qty-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.qty-row__label { color: var(--text-sub); width: 180rpx; font-size: 26rpx; }
.qty-row__btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-soft) 0%, #FFE0EC 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 300;
  flex-shrink: 0;
}
.qty-row__btn:active { opacity: 0.6; }
.qty-row__num {
  min-width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  color: var(--text);
  font-weight: 600;
}
.qty-row__field {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text);
}
.qty-row__placeholder { color: var(--text-mute); }

.total-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0 20rpx;
  border-top: 1rpx solid var(--line-soft);
  margin-top: 4rpx;
}
.total-display__label { color: var(--text-sub); font-size: 26rpx; }
.total-display__amount {
  font-size: 44rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
}
.total-display__hint { font-size: 22rpx; color: var(--text-mute); margin-left: 12rpx; }

/* === 切换按钮组 === */
.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 0;
  flex: 1;
}

/* === Switch 行 === */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.switch-row__label { color: var(--text); font-size: 28rpx; font-weight: 500; }
.switch-row__hint { color: var(--text-mute); font-size: 22rpx; margin-left: 12rpx; }

/* === 更多信息折叠 === */
.more-toggle {
  text-align: center;
  color: var(--text-sub);
  padding: 20rpx 0;
  font-size: 26rpx;
  font-weight: 500;
}
.more-toggle__arrow { margin-left: 6rpx; color: var(--primary); }

/* === 自动补全 === */
.suggest-box {
  background: rgba(255, 255, 255, 0.7);
  border-top: 1rpx solid var(--line-soft);
  margin: 0 -32rpx -4rpx;
  padding: 12rpx 32rpx;
  border-radius: 0 0 24rpx 24rpx;
}
.suggest-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.suggest-item {
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  background: var(--primary-soft);
  color: var(--primary);
  border-radius: 999rpx;
  font-weight: 500;
}
.suggest-item:active { opacity: 0.7; }

/* === 提交 === */
.submit-bar {
  position: fixed;
  left: 0; right: 0;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 100rpx);
  padding: 20rpx 32rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid rgba(255, 148, 185, 0.15);
  display: flex;
  gap: 16rpx;
  z-index: 50;
}
.submit-bar .btn { flex: 1; }
.submit-bar-spacer {
  height: calc(160rpx + env(safe-area-inset-bottom, 0px));
}

/* === 商品图片选择 === */
.input-cell--stack {
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx 0;
}
.input-cell--stack .input-cell__label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  width: auto;
}
.input-cell__hint {
  font-size: 22rpx;
  color: var(--text-mute);
  font-weight: normal;
}

.img-picked {
  position: relative;
  display: inline-block;
  margin-top: 8rpx;
}
.img-picked__thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line-soft);
  background: var(--bg-elev);
}
.img-picked__remove {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--danger);
  color: #fff;
  font-size: 28rpx;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.4);
}
.img-picked__status {
  font-size: 22rpx;
  color: var(--text-mute);
  margin-top: 8rpx;
}
