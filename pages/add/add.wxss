/* pages/add/add.wxss */
.add-page {
  padding: 24rpx 32rpx 60rpx;
  min-height: 100vh;
}

/* === 类型选择（第一步）=== */
.type-card {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.type-card__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  background: var(--primary-soft);
  color: var(--primary);
}
.type-card__icon--game {
  background: var(--accent-soft);
  color: var(--accent);
}
.type-card__main { flex: 1; }
.type-card__title { font-size: 32rpx; color: var(--text); font-weight: 500; }
.type-card__desc { font-size: 24rpx; color: var(--text-mute); margin-top: 6rpx; }
.type-card__arrow { font-size: 40rpx; color: var(--text-mute); }

/* === 表单 === */
.form-card {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 24rpx;
}

.qty-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.qty-row__label { color: var(--text-sub); width: 180rpx; }
.qty-row__btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line);
  background: var(--bg-elev);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text);
}
.qty-row__num {
  min-width: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  color: var(--text);
}
.qty-row__field {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: var(--text);
}
.qty-row__placeholder { color: var(--text-mute); }

.total-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--line-soft);
}
.total-display__label { color: var(--text-sub); }
.total-display__amount {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
}
.total-display__hint { font-size: 22rpx; color: var(--text-mute); margin-left: 12rpx; }

/* === 切换按钮组（官方/同人 / 氪金原因）=== */
.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 20rpx 0;
}
.pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--line);
  color: var(--text-sub);
}
.pill--active {
  background: var(--primary-soft);
  color: var(--primary);
  border-color: var(--primary);
}

/* === Switch 行 === */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.switch-row__label { color: var(--text); font-size: 28rpx; }
.switch-row__hint { color: var(--text-mute); font-size: 22rpx; margin-left: 12rpx; }

/* === 更多信息折叠 === */
.more-toggle {
  text-align: center;
  color: var(--text-sub);
  padding: 16rpx 0;
  font-size: 26rpx;
}
.more-toggle__arrow { margin-left: 6rpx; }

/* === 自动补全 === */
.suggest-box {
  background: var(--bg-elev);
  border-top: 1rpx solid var(--line-soft);
  margin: 0 -32rpx -8rpx;
  padding: 12rpx 32rpx;
}
.suggest-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.suggest-item {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  background: var(--line-soft);
  color: var(--text-sub);
  border-radius: 6rpx;
}

/* === 提交 === */
.submit-bar {
  position: fixed;
  left: 0; right: 0;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 100rpx);
  padding: 20rpx 32rpx 20rpx;
  background: var(--bg);
  border-top: 1rpx solid var(--line);
  display: flex;
  gap: 16rpx;
  z-index: 50;
}
.submit-bar .btn { flex: 1; }
.submit-bar-spacer {
  height: calc(160rpx + env(safe-area-inset-bottom, 0px));
}

/* === 商品图片选择（PRD 4.2.4）=== */
.input-cell--stack {
  flex-direction: column;
  align-items: stretch;
  padding: 24rpx 0;
}
.input-cell--stack .input-cell__label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.input-cell__hint {
  font-size: 22rpx;
  color: var(--text-mute);
  font-weight: normal;
}

.img-picked {
  position: relative;
  display: inline-block;
  margin-top: 8rpx;
}
.img-picked__thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: var(--bg-elev);
}
.img-picked__remove {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--danger);
  color: #fff;
  font-size: 28rpx;
  border: 2rpx solid var(--bg-card);
}
.img-picked__status {
  font-size: 22rpx;
  color: var(--text-mute);
  margin-top: 8rpx;
}
