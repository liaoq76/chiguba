<view class="container">
  <view class="card summary">
    <view class="summary-row">
      <view>
        <view class="muted">本月花销</view>
        <view class="big-amount">¥ {{monthTotal}}</view>
      </view>
      <view>
        <view class="muted">当前筛选</view>
        <view class="amount">¥ {{total}}</view>
      </view>
    </view>
  </view>

  <view class="search-row">
    <input class="search-input" placeholder="搜索商品 / 备注" bindinput="onSearch" value="{{keyword}}" />
    <view class="add-shortcut" bindtap="goAdd">＋</view>
  </view>

  <scroll-view class="cat-tabs" scroll-x>
    <view class="cat-tab {{activeCat === 'all' ? 'active' : ''}}" data-id="all" bindtap="switchCat">全部</view>
    <view class="cat-tab {{activeCat === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="switchCat">
      {{item.icon}} {{item.name}}
    </view>
  </scroll-view>

  <view wx:if="{{!empty}}">
    <view class="day-group" wx:for="{{groups}}" wx:key="day" wx:for-item="group">
      <view class="day-header">
        <text class="day-label">{{group.day}}</text>
        <text class="day-total">合计 ¥ {{group.dayTotal}}</text>
      </view>
      <view class="card record-list">
        <view class="record-row" wx:for="{{group.list}}" wx:key="id" wx:for-item="r" bindtap="goDetail" data-id="{{r.id}}">
          <view class="record-icon" style="background: {{r.categoryColor}}22; color: {{r.categoryColor}}">{{r.categoryIcon}}</view>
          <view class="record-main">
            <view class="record-title">{{r.title || r.categoryName}}</view>
            <view class="record-sub muted">{{r.timeLabel}} · {{r.categoryName}}</view>
          </view>
          <view class="record-amount amount">¥ {{r.amount}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{empty}}">
    <view>这里空空如也～</view>
    <view class="primary-btn add-btn" bindtap="goAdd">去记一笔</view>
  </view>
</view>