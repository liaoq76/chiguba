.summary {
  background: linear-gradient(135deg, #ffd1e1, #ffe7f0);
  border: none;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.big-amount {
  font-size: 50rpx;
  font-weight: 700;
  color: #c93a76;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.search-input {
  flex: 1;
  background: #fff;
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 111, 157, 0.06);
}

.add-shortcut {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ff6f9d;
  color: #fff;
  text-align: center;
  line-height: 68rpx;
  font-size: 44rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 111, 157, 0.3);
}

.cat-tabs {
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 6rpx 0;
}

.cat-tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.cat-tab.active {
  background: #ff6f9d;
  color: #fff;
  border-color: #ff6f9d;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 4rpx 12rpx;
}

.day-label {
  font-weight: 600;
  color: #555;
  font-size: 26rpx;
}

.day-total {
  font-size: 22rpx;
  color: #ff6f9d;
}

.record-list {
  padding: 8rpx 0;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #f5e6ec;
}

.record-row:last-child { border-bottom: none; }

.record-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.record-main { flex: 1; min-width: 0; }

.record-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-sub { margin-top: 4rpx; font-size: 22rpx; }

.record-amount {
  font-size: 28rpx;
  margin-left: 12rpx;
  white-space: nowrap;
}

.empty .add-btn {
  margin-top: 24rpx;
  width: 60%;
  margin-left: auto;
  margin-right: auto;
}