/* pages/guide/guide.wxss — V2 樱花粉 UI */
.guide-page {
  min-height: 100vh;
  background: linear-gradient(160deg, var(--bg-grad-from) 0%, var(--bg-grad-to) 100%);
  padding: 60rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
}
.guide-skip {
  align-self: flex-end;
  color: var(--text-mute);
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-weight: 500;
}
.guide-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 40rpx 0;
}
.guide-card__inner {
  width: 320rpx;
  height: 320rpx;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
  box-shadow: 0 20rpx 60rpx rgba(255, 148, 185, 0.35);
  position: relative;
  overflow: hidden;
}
.guide-seal {
  font-size: 180rpx;
  line-height: 1;
  position: relative;
  z-index: 2;
}
.guide-title {
  font-size: 48rpx;
  color: var(--text);
  font-weight: 700;
  letter-spacing: 2rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}
.guide-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.7;
  max-width: 480rpx;
}

.guide-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
}
.guide-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: var(--line);
  transition: all 0.25s ease;
}
.guide-dot--active {
  background: linear-gradient(90deg, var(--primary) 0%, var(--secondary) 100%);
  width: 40rpx;
  border-radius: 8rpx;
}

.guide-nav {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 60rpx;
}
.guide-nav .btn { flex: 1; }
