/* pages/guide/guide.wxss */
.guide-page {
  min-height: 100vh;
  background: var(--bg);
  padding: 60rpx 60rpx 40rpx;
  display: flex;
  flex-direction: column;
}
.guide-skip {
  align-self: flex-end;
  color: var(--text-mute);
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}
.guide-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 40rpx 0;
}
.guide-seal {
  font-size: 220rpx;
  color: var(--primary);
  line-height: 1;
  margin-bottom: 40rpx;
}
.guide-title {
  font-size: 48rpx;
  color: var(--text);
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 24rpx;
}
.guide-desc {
  font-size: 28rpx;
  color: var(--text-sub);
  line-height: 1.7;
  max-width: 480rpx;
}

.guide-dots {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 0;
}
.guide-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: var(--line);
}
.guide-dot--active {
  background: var(--primary);
  width: 32rpx;
  border-radius: 8rpx;
}

.guide-nav {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 60rpx;
}
.guide-nav .btn { flex: 1; }
