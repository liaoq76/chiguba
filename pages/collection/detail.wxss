/* pages/collection/detail.wxss — V2 樱花粉 UI */
.coll-detail-page { padding-bottom: 200rpx; padding-top: 16rpx; }

.coll-detail-hero {
  margin: 0 28rpx 20rpx;
  padding: 36rpx 32rpx;
  border-radius: 28rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(255, 148, 185, 0.35);
}
.coll-detail-hero__icon {
  width: 130rpx; height: 130rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 64rpx;
  margin: 0 auto 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.coll-detail-hero__name {
  font-size: 38rpx;
  color: #fff;
  font-weight: 700;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 2;
}
.coll-detail-hero__qty {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  position: relative;
  z-index: 2;
}
.coll-detail-hero__qty-item { text-align: center; }
.coll-detail-hero__qty-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 2rpx;
  font-weight: 500;
}
.coll-detail-hero__qty-num {
  font-size: 52rpx;
  color: #fff;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  margin-top: 4rpx;
}
.coll-detail-hero__qty-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

.qty-control {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 24rpx;
}
.qty-control__btn {
  width: 80rpx; height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
  color: #fff;
  font-size: 40rpx;
  display: flex; align-items: center; justify-content: center;
  line-height: 1;
  box-shadow: 0 4rpx 16rpx var(--shadow-primary);
  font-weight: 300;
}
.qty-control__btn--minus {
  background: rgba(255, 255, 255, 0.7);
  color: var(--text);
  border: 1rpx solid var(--line);
  box-shadow: none;
}
.qty-control__num {
  min-width: 120rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--text);
}

.qty-edit-row {
  text-align: center;
  padding: 0 32rpx 24rpx;
}
.qty-edit-row__editing {
  display: flex;
  gap: 12rpx;
  justify-content: center;
  align-items: center;
}
.edit-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
}
.edit-row__field {
  flex: 1;
  font-size: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid var(--line);
  padding: 8rpx 0;
}

.section {
  margin: 0 28rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 8rpx 0;
}
.section__row {
  display: flex;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
  align-items: center;
}
.section__row:last-child { border-bottom: 0; }
.section__row--head {
  background: var(--line-soft);
}
.section__label { color: var(--text-sub); width: 200rpx; font-size: 26rpx; }
.section__value { flex: 1; color: var(--text); font-size: 26rpx; }
.section__value--right { text-align: right; font-size: 22rpx; }

.expense-row {
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.expense-row:last-child { border-bottom: 0; }
.expense-row__main { flex: 1; min-width: 0; }
.expense-row__name { font-size: 26rpx; color: var(--text); font-weight: 500; }
.expense-row__date { font-size: 22rpx; color: var(--text-mute); margin-top: 4rpx; }
.expense-row__qty {
  font-size: 26rpx;
  color: var(--primary);
  font-variant-numeric: tabular-nums;
  margin-right: 16rpx;
  background: var(--primary-soft);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-weight: 500;
}
.expense-row__amount {
  font-size: 26rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}

.empty-cell {
  padding: 32rpx;
  text-align: center;
  color: var(--text-mute);
  font-size: 24rpx;
}
