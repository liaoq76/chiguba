/* pages/collection/history.wxss — V2 樱花粉 UI */
.coll-page { padding-bottom: 200rpx; padding-top: 16rpx; }
.coll-list {
  margin: 0 28rpx;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 8rpx 0;
}
.coll-list__item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.coll-list__item:last-child { border-bottom: 0; }
.coll-list__item:active { background: rgba(255, 255, 255, 0.5); }
.coll-list__icon {
  width: 76rpx; height: 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--primary-soft) 0%, #FFE0EC 100%);
  color: var(--primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(255, 148, 185, 0.15);
}
.coll-list__icon--history {
  background: rgba(241, 245, 249, 0.8);
  color: var(--text-mute);
  box-shadow: none;
}
.coll-list__main { flex: 1; min-width: 0; }
.coll-list__name { font-size: 28rpx; color: var(--text); font-weight: 500; }
.coll-list__sub { font-size: 22rpx; color: var(--text-mute); margin-top: 4rpx; }
