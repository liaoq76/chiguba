<!-- pages/data/data.wxml — 数据导出（粉色 Hero V2） -->
<view class="data-page">

  <!-- === 粉色渐变 Hero === -->
  <view class="data-hero">
    <view class="data-hero__bg data-hero__bg--1"></view>
    <view class="data-hero__bg data-hero__bg--2"></view>

    <view class="data-hero__top">
      <view class="data-hero__title-block">
        <view class="data-hero__title">数据导出</view>
        <view class="data-hero__subtitle">备份、导出、清理一站式管理</view>
      </view>
      <view class="data-hero__icon">📊</view>
    </view>

    <!-- 同步状态卡 -->
    <view class="data-hero__sync">
      <view class="data-hero__sync-row">
        <view class="data-hero__sync-dot {{!online ? 'data-hero__sync-dot--off' : ''}}"></view>
        <text class="data-hero__sync-text">{{online ? '网络正常 · 数据已自动同步' : '网络异常'}}</text>
      </view>
      <view class="data-hero__sync-stat">
        <view class="data-hero__sync-cell">
          <text class="data-hero__sync-num">{{queueCount}}</text>
          <text class="data-hero__sync-label">总记录</text>
        </view>
        <view class="data-hero__sync-cell">
          <text class="data-hero__sync-num data-hero__sync-num--warn">{{pendingSync}}</text>
          <text class="data-hero__sync-label">待同步</text>
        </view>
        <view class="data-hero__sync-cell">
          <text class="data-hero__sync-num data-hero__sync-num--danger">{{failedCount}}</text>
          <text class="data-hero__sync-label">失败</text>
        </view>
      </view>
    </view>
  </view>

  <!-- === 数据导出 === -->
  <view class="data-section-title">数据导出</view>
  <view class="data-card">
    <view class="data-row" bindtap="doExport">
      <view class="data-row__icon data-row__icon--pink">⇋</view>
      <view class="data-row__main">
        <view class="data-row__title">导出全部数据</view>
        <view class="data-row__desc">生成 XLSX 文件，可在小程序内查看</view>
      </view>
      <text class="data-row__arrow">›</text>
    </view>
    <view class="data-row">
      <view class="data-row__icon data-row__icon--purple">⏱</view>
      <view class="data-row__main">
        <view class="data-row__title">上次导出</view>
        <view class="data-row__desc">{{lastExportAt}}</view>
      </view>
    </view>
  </view>

  <!-- === 同步队列 === -->
  <view class="data-section-title">同步队列</view>
  <view class="data-card">
    <view class="data-row" wx:if="{{failedCount > 0}}" bindtap="retrySync">
      <view class="data-row__icon data-row__icon--danger">!</view>
      <view class="data-row__main">
        <view class="data-row__title">重试失败项</view>
        <view class="data-row__desc">{{failedCount}} 条同步失败</view>
      </view>
      <text class="data-row__arrow">›</text>
    </view>
    <view class="data-row" wx:if="{{pendingSync > 0}}" bindtap="cleanQueue">
      <view class="data-row__icon data-row__icon--gray">⌫</view>
      <view class="data-row__main">
        <view class="data-row__title">清理已同步/失败项</view>
        <view class="data-row__desc">云端已有数据时，清掉本地残留队列</view>
      </view>
      <text class="data-row__arrow">›</text>
    </view>
    <view class="data-row" wx:if="{{pendingSync === 0 && failedCount === 0}}">
      <view class="data-row__icon data-row__icon--mint">✓</view>
      <view class="data-row__main">
        <view class="data-row__title">队列已清空</view>
        <view class="data-row__desc">所有数据均已同步至云端</view>
      </view>
    </view>
  </view>

  <!-- === 备份设置 === -->
  <view class="data-section-title">备份设置</view>
  <view class="data-card">
    <view class="data-row data-row--switch">
      <view class="data-row__icon data-row__icon--blue">☁</view>
      <view class="data-row__main">
        <view class="data-row__title">云端自动备份</view>
        <view class="data-row__desc">每天 09:00 自动备份</view>
      </view>
      <switch checked="{{backupEnabled}}" bindchange="toggleBackup" color="#FF6B9D"></switch>
    </view>
    <view class="data-row">
      <view class="data-row__icon data-row__icon--green">↻</view>
      <view class="data-row__main">
        <view class="data-row__title">最近备份</view>
        <view class="data-row__desc">{{lastBackupAt}}</view>
      </view>
    </view>
  </view>

  <!-- === 清空数据 === -->
  <view class="data-section-title">危险操作</view>
  <view class="data-card">
    <view class="data-row" bindtap="doClear">
      <view class="data-row__icon data-row__icon--danger">⌫</view>
      <view class="data-row__main">
        <view class="data-row__title data-row__title--danger">清空全部数据</view>
        <view class="data-row__desc">清空业务数据，个人词库保留</view>
      </view>
      <text class="data-row__arrow">›</text>
    </view>
  </view>
</view>
