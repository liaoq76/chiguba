/* pages/data/feedback.wxss */
.feedback-page { padding: 24rpx 32rpx 80rpx; }
.form-card {
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}
.label { font-size: 24rpx; color: var(--text-mute); margin-bottom: 16rpx; letter-spacing: 2rpx; }
.textarea {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  color: var(--text);
  background: transparent;
}
.input {
  width: 100%;
  font-size: 28rpx;
  color: var(--text);
  padding: 12rpx 0;
}
.submit-btn {
  margin-top: 24rpx;
  width: 100%;
}
