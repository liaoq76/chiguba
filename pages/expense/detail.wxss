/* pages/expense/detail.wxss — V2 樱花粉 UI */
.detail-page { padding-bottom: 200rpx; padding-top: 16rpx; }

.detail-hero {
  margin: 0 28rpx 20rpx;
  padding: 40rpx 32rpx;
  border-radius: 28rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(255, 148, 185, 0.35);
}
.detail-hero__name {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 16rpx;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 2;
}
.detail-hero__amount {
  font-size: 80rpx;
  color: #fff;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  letter-spacing: 2rpx;
  line-height: 1.1;
  position: relative;
  z-index: 2;
}
.detail-hero__type {
  display: inline-block;
  margin-top: 20rpx;
  position: relative;
  z-index: 2;
}
.detail-hero__tag {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-weight: 500;
}

.section {
  margin: 0 28rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 8rpx 0;
}
.section__head {
  padding: 20rpx 32rpx 12rpx;
  font-size: 22rpx;
  color: var(--text-mute);
  letter-spacing: 4rpx;
  font-weight: 500;
  text-transform: uppercase;
}
.section__row {
  display: flex;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.section__row:last-child { border-bottom: 0; }
.section__label { color: var(--text-sub); width: 200rpx; font-size: 26rpx; }
.section__value { flex: 1; color: var(--text); font-size: 26rpx; }
.section__value.is-empty { color: var(--text-mute); }

/* === 商品图片网格 === */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 8rpx 32rpx 24rpx;
}
.image-grid__item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: var(--bg-elev);
  border: 1rpx solid var(--line-soft);
}

/* === 操作栏 === */
.action-bar {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  margin: 16rpx 28rpx 0;
  background: transparent;
  z-index: 50;
}
.action-bar .btn { flex: 1; }

.empty-cell {
  padding: 32rpx;
  text-align: center;
  color: var(--text-mute);
  font-size: 24rpx;
}
