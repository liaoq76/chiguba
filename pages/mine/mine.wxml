<!-- pages/mine/mine.wxml -->
<view class="mine-page">

  <!-- 用户信息 -->
  <view class="mine-hero">
    <!-- 头像：用外层 view 严格限定 110rpx，内嵌 button 作为 hit-area -->
    <view class="mine-hero__avatar-wrap">
      <image wx:if="{{avatarURL}}" class="mine-hero__avatar" src="{{avatarURL}}" mode="aspectFill"></image>
      <view wx:else class="mine-hero__avatar mine-hero__avatar--placeholder">人</view>
      <button class="mine-hero__avatar-btn"
              open-type="chooseAvatar"
              bind:chooseavatar="onWxChooseAvatar"></button>
    </view>
    <view class="mine-hero__main">
      <view class="mine-hero__name" bindtap="onNickTap">{{nickname}}</view>
      <view class="mine-hero__status" wx:if="{{pendingSync > 0 || !online}}">
        <view class="mine-hero__dot {{!online ? 'mine-hero__dot--off' : ''}}"></view>
        <text wx:if="{{!online}}">网络异常 · </text>
        <text wx:if="{{pendingSync > 0}}">{{pendingSync}} 条待同步</text>
      </view>
    </view>
    <!-- 右侧箭头，提示昵称可点击编辑 -->
    <view class="mine-hero__arrow" bindtap="onNickTap">›</view>
  </view>

  <!-- 昵称编辑弹层（fixed 全屏遮罩 + 表单） -->
  <view class="nick-overlay {{nickVisible ? 'nick-overlay--show' : ''}}" bindtap="onNickCancel" catchtouchmove="prevent">
    <view class="nick-panel" catchtap="stopProp">
      <view class="nick-panel__title">修改昵称</view>
      <form bindsubmit="onNickSubmit">
        <input type="nickname"
               class="nick-panel__input"
               name="nickname"
               placeholder="请输入昵称"
               value="{{nickInput}}"
               maxlength="24"
               focus="{{nickFocus}}"
               bindnicknamereview="onNickReview" />
        <view class="nick-panel__tip" wx:if="{{nickReviewed && !nickPass}}">昵称包含敏感内容，请重新输入</view>
        <view class="nick-panel__actions">
          <view class="nick-panel__btn nick-panel__btn--cancel" bindtap="onNickCancel">取消</view>
          <button class="nick-panel__btn nick-panel__btn--confirm" form-type="submit">保存</button>
        </view>
      </form>
    </view>
  </view>

  <!-- 消费管理 -->
  <view class="mine-section-title">消费管理</view>
  <view class="mine-card">
    <view class="mine-row" bindtap="goBudget">
      <view class="mine-row__icon mine-row__icon--gold">⊕</view>
      <view class="mine-row__title">预算</view>
      <text class="mine-row__arrow">›</text>
    </view>
    <view class="mine-row" bindtap="goStats">
      <view class="mine-row__icon mine-row__icon--accent">⌒</view>
      <view class="mine-row__title">消费统计</view>
      <text class="mine-row__arrow">›</text>
    </view>
  </view>

  <!-- 我的数据 -->
  <view class="mine-section-title">我的数据</view>
  <view class="mine-card">
    <view class="mine-row" bindtap="goPresale">
      <view class="mine-row__icon mine-row__icon--accent">◫</view>
      <view class="mine-row__title">预售管理</view>
      <text class="mine-row__arrow">›</text>
    </view>
    <view class="mine-row" bindtap="goVocab">
      <view class="mine-row__icon">⌘</view>
      <view class="mine-row__title">个人词库</view>
      <text class="mine-row__arrow">›</text>
    </view>
    <view class="mine-row" bindtap="goData">
      <view class="mine-row__icon mine-row__icon--gold">⇋</view>
      <view class="mine-row__title">数据管理</view>
      <text class="mine-row__arrow">›</text>
    </view>
  </view>

  <!-- 其他 -->
  <view class="mine-section-title">其他</view>
  <view class="mine-card">
    <view class="mine-row" bindtap="goAbout">
      <view class="mine-row__icon mine-row__icon--warn">ⓘ</view>
      <view class="mine-row__title">关于吃谷吗</view>
      <text class="mine-row__arrow">›</text>
    </view>
  </view>
</view>
