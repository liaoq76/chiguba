<!-- pages/mine/mine.wxml — V2 严格复刻原型 -->
<view class="mine-page">

  <!-- ============== 主页 (activeSubPage === 'main') ============== -->
  <block wx:if="{{activeSubPage === 'main'}}">

    <!-- ========== 渐变 Profile Hero ========== -->
    <view class="mine-hero">
      <view class="mine-hero__bg-blur mine-hero__bg-blur--1"></view>
      <view class="mine-hero__bg-blur mine-hero__bg-blur--2"></view>
      <view class="mine-hero__bg-icon">★</view>

      <view class="mine-hero__top">
        <view class="mine-hero__avatar-wrap">
          <image wx:if="{{avatarURL}}" class="mine-hero__avatar" src="{{avatarURL}}" mode="aspectFill"></image>
          <view wx:else class="mine-hero__avatar mine-hero__avatar--placeholder">人</view>
          <button class="mine-hero__avatar-btn"
                  open-type="chooseAvatar"
                  bind:chooseavatar="onWxChooseAvatar"></button>
          <view class="mine-hero__avatar-edit">
            <text>✎</text>
          </view>
        </view>
        <view class="mine-hero__main">
          <view class="mine-hero__name-row">
            <text class="mine-hero__name" bindtap="onNickTap">{{nickname}}</text>
            <text class="mine-hero__level">Lv.1</text>
          </view>
          <text class="mine-hero__bio">吃谷使我快乐，吃土使我清醒 🛍</text>
          <text class="mine-hero__join">入坑第 {{joinDays}} 天</text>
        </view>
      </view>

      <!-- Stat strip 3列 -->
      <view class="mine-hero__stats">
        <view class="mine-hero__stat">
          <text class="mine-hero__stat-val">¥0</text>
          <text class="mine-hero__stat-label">谷库估值</text>
        </view>
        <view class="mine-hero__stat">
          <text class="mine-hero__stat-val">0</text>
          <text class="mine-hero__stat-label">收藏件数</text>
        </view>
        <view class="mine-hero__stat">
          <text class="mine-hero__stat-val">0</text>
          <text class="mine-hero__stat-label">追IP数</text>
        </view>
      </view>
    </view>

    <!-- 同步状态 (轻量条) -->
    <view class="mine-syncbar" wx:if="{{pendingSync > 0 || !online}}">
      <view class="mine-syncbar__dot {{!online ? 'mine-syncbar__dot--off' : ''}}"></view>
      <text wx:if="{{!online}}">网络异常 · </text>
      <text wx:if="{{pendingSync > 0}}">{{pendingSync}} 条待同步</text>
      <text wx:else>数据已同步 ✓</text>
    </view>

    <!-- ========== 常用功能 4 列 ========== -->
    <view class="mine-section">
      <view class="mine-section__title">常用功能</view>
      <view class="mine-quick">
        <view class="mine-quick__item" bindtap="goPresale">
          <view class="mine-quick__icon mine-quick__icon--pink">
            <text>🚚</text>
          </view>
          <text class="mine-quick__label">预售管理</text>
        </view>
        <view class="mine-quick__item" bindtap="goVocab">
          <view class="mine-quick__icon mine-quick__icon--purple">
            <text>🏷</text>
          </view>
          <text class="mine-quick__label">吃谷词库</text>
        </view>
        <view class="mine-quick__item" bindtap="goBudget">
          <view class="mine-quick__icon mine-quick__icon--violet">
            <text>💰</text>
          </view>
          <text class="mine-quick__label">预算管理</text>
        </view>
        <view class="mine-quick__item" bindtap="goData">
          <view class="mine-quick__icon mine-quick__icon--emerald">
            <text>📊</text>
          </view>
          <text class="mine-quick__label">数据导出</text>
        </view>
      </view>
    </view>

    <!-- ========== 更多 列表 ========== -->
    <view class="mine-section">
      <view class="mine-section__title">更多</view>
      <view class="mine-list float-card">
        <view class="mine-list__row" bindtap="goSettings">
          <view class="mine-list__icon mine-list__icon--gray">
            <text>⚙</text>
          </view>
          <text class="mine-list__title">通用设置</text>
          <text class="mine-list__arrow">›</text>
        </view>
        <view class="mine-list__row" bindtap="onShare">
          <view class="mine-list__icon mine-list__icon--pink">
            <text>↗</text>
          </view>
          <text class="mine-list__title">推荐给同好</text>
          <text class="mine-list__arrow">›</text>
        </view>
        <view class="mine-list__row" bindtap="goHelp">
          <view class="mine-list__icon mine-list__icon--blue">
            <text>?</text>
          </view>
          <text class="mine-list__title">帮助与反馈</text>
          <text class="mine-list__arrow">›</text>
        </view>
        <view class="mine-list__row" bindtap="goAbout">
          <view class="mine-list__icon mine-list__icon--violet">
            <text>ⓘ</text>
          </view>
          <text class="mine-list__title">关于吃谷吗</text>
          <text class="mine-list__version">v1.0.0</text>
        </view>
      </view>
    </view>
  </block>

  <!-- 昵称编辑弹层 (始终渲染) -->
  <view class="nick-overlay {{nickVisible ? 'nick-overlay--show' : ''}}" bindtap="onNickCancel" catchtouchmove="prevent">
    <view class="nick-panel float-card" catchtap="stopProp">
      <view class="nick-panel__title">修改昵称</view>
      <form bindsubmit="onNickSubmit">
        <input type="nickname"
               class="nick-panel__input"
               name="nickname"
               placeholder="请输入昵称"
               value="{{nickInput}}"
               maxlength="24"
               focus="{{nickFocus}}"
               bindnicknamereview="onNickReview" />
        <view class="nick-panel__tip" wx:if="{{nickReviewed && !nickPass}}">昵称包含敏感内容，请重新输入</view>
        <view class="nick-panel__actions">
          <view class="nick-panel__btn nick-panel__btn--cancel" bindtap="onNickCancel">取消</view>
          <button class="nick-panel__btn nick-panel__btn--confirm" form-type="submit">保存</button>
        </view>
      </form>
    </view>
  </view>
</view>
