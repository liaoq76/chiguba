/* pages/mine/mine.wxss */
.mine-page { padding-bottom: 80rpx; }
.mine-hero {
  padding: 48rpx 32rpx 32rpx;
  background: var(--bg-card);
  margin: 16rpx 28rpx 0;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
}
.mine-hero__avatar-wrap {
  position: relative;
  width: 110rpx;
  height: 110rpx;
  min-width: 0;
  flex: none;
  margin-right: 24rpx;
  border-radius: 50%;
  overflow: hidden;
  pointer-events: none; /* 防止外层捕获点击 */
}
.mine-hero__avatar-btn {
  position: absolute;
  left: 0;
  top: 0;
  width: 110rpx;
  height: 110rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 50%;
  overflow: hidden;
  font-size: 0;
  line-height: 0;
  pointer-events: auto; /* 让 button 可点击 */
}
.mine-hero__avatar-btn::before,
.mine-hero__avatar-btn::after {
  display: none;
  content: none;
  border: 0;
  width: 0;
  height: 0;
}
.mine-hero__avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: block;
}
.mine-hero__avatar--placeholder {
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mine-hero__avatar--placeholder {
  width: 110rpx; height: 110rpx;
  background: var(--primary-soft);
  color: var(--primary);
  font-size: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  flex: none;
}
.mine-hero__main { flex: 1; min-width: 0; padding-left: 8rpx; }
.mine-hero__name {
  font-size: 36rpx; color: var(--text); font-weight: 500;
  padding: 8rpx 0;
}
.mine-hero__arrow {
  font-size: 44rpx; color: var(--text-mute); padding: 0 16rpx;
  align-self: center;
}
.mine-hero__status {
  display: flex; align-items: center; gap: 8rpx;
  font-size: 22rpx; color: var(--text-mute); margin-top: 6rpx;
}
.mine-hero__dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--accent);
}
.mine-hero__dot--off { background: var(--warn); }

/* === 昵称编辑弹层 === */
.nick-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,0);
  z-index: 998;
  pointer-events: none;
  transition: background 0.25s ease;
}
.nick-overlay--show {
  background: rgba(0,0,0,0.45);
  pointer-events: auto;
}
.nick-panel {
  position: fixed;
  left: 50%; top: 50%;
  transform: translate(-50%, -50%) scale(0.92);
  width: 600rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 40rpx 40rpx 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.18);
  opacity: 0;
  transition: opacity 0.22s ease, transform 0.22s ease;
  pointer-events: none;
}
.nick-overlay--show .nick-panel {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
  pointer-events: auto;
}
.nick-panel__title {
  font-size: 34rpx; font-weight: 500;
  color: var(--text); text-align: center;
  margin-bottom: 32rpx;
}
.nick-panel__input {
  background: var(--bg-elev);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  height: 88rpx; padding: 0 24rpx;
  font-size: 30rpx; color: var(--text);
}
.nick-panel__tip {
  font-size: 24rpx; color: var(--danger);
  margin-top: 16rpx;
}
.nick-panel__actions {
  display: flex; gap: 20rpx;
  margin-top: 32rpx;
}
.nick-panel__btn {
  flex: 1; height: 88rpx; border-radius: 12rpx;
  font-size: 30rpx; text-align: center; line-height: 88rpx;
}
.nick-panel__btn--cancel {
  background: var(--bg-elev);
  border: 1rpx solid var(--line);
  color: var(--text);
}
.nick-panel__btn--confirm {
  background: var(--primary); color: #fff;
  border: 0; font-weight: 500;
}
.nick-panel__btn--confirm::after { content: none; }

/* === 原有 section / card / row 样式（保留）=== */
.mine-section-title {
  padding: 32rpx 32rpx 12rpx;
  font-size: 24rpx; color: var(--text-mute);
  letter-spacing: 4rpx;
}
.mine-card {
  background: var(--bg-card);
  margin: 0 28rpx 16rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--line);
  overflow: hidden;
}
.mine-row {
  display: flex; align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.mine-row:last-child { border-bottom: 0; }
.mine-row__icon {
  font-size: 32rpx; margin-right: 20rpx;
  width: 40rpx; text-align: center;
}
.mine-row__icon--gold { color: var(--accent); }
.mine-row__icon--accent { color: var(--primary); }
.mine-row__icon--warn { color: var(--warn); }
.mine-row__title { flex: 1; font-size: 30rpx; color: var(--text); }
.mine-row__arrow { font-size: 32rpx; color: var(--text-mute); }
