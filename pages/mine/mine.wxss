.profile-card {
  background: linear-gradient(135deg, #ffd1e1, #ffe7f0);
  border: none;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
}

.profile-main { flex: 1; }
.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #5a2c3d;
}

.edit-btn {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  border-radius: 32rpx;
}

.profile-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.6);
}

.stat { text-align: center; flex: 1; }

.stat-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #c93a76;
}

.tabs {
  display: flex;
  padding: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.tab.active {
  background: #ff6f9d;
  color: #fff;
}

.text-input {
  background: #f7f0f4;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.cat-list { margin-bottom: 16rpx; }

.cat-cell {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5e6ec;
}

.cat-cell:last-child { border-bottom: none; }

.cat-cell .cat-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.cat-cell .cat-name { flex: 1; font-size: 28rpx; }

.cat-del {
  font-size: 24rpx;
  color: #ff4d4f;
  padding: 8rpx 16rpx;
  border: 1rpx solid #ff4d4f;
  border-radius: 16rpx;
}

.reset-btn {
  margin-top: 16rpx;
}

.pref-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5e6ec;
  font-size: 26rpx;
}

.pref-row:last-child { border-bottom: none; }

.about-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 16rpx;
}

.about-text .bold { font-weight: 600; color: #ff6f9d; }

.danger-btn {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 48rpx;
  font-size: 28rpx;
  padding: 16rpx 0;
  text-align: center;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.modal {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}

.modal-section {
  font-size: 24rpx;
  color: #888;
  margin: 24rpx 0 12rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.icon-cell {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: #fff7fb;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border: 2rpx solid transparent;
}

.icon-cell.active {
  border-color: #ff6f9d;
  background: #ffe7f0;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.color-cell {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
}

.color-cell.active {
  border-color: #333;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.modal-actions .ghost-btn,
.modal-actions .primary-btn {
  flex: 1;
}