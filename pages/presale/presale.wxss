/* pages/presale/presale.wxss */
.presale-page { padding-bottom: 80rpx; }

.tabs {
  display: flex;
  margin: 16rpx 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 6rpx;
}
.tabs__item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: var(--text-sub);
  border-radius: 8rpx;
}
.tabs__item--active {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 500;
}

.presale-list {
  margin: 0 28rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  overflow: hidden;
}
.presale-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.presale-item:last-child { border-bottom: 0; }
.presale-item__icon {
  width: 72rpx; height: 72rpx;
  border-radius: 18rpx;
  background: var(--accent-soft);
  color: var(--accent);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
}
.presale-item__icon--received {
  background: var(--line-soft);
  color: var(--text-mute);
}
.presale-item__main { flex: 1; }
.presale-item__name {
  font-size: 28rpx;
  color: var(--text);
}
.presale-item__sub {
  font-size: 22rpx;
  color: var(--text-mute);
  margin-top: 6rpx;
}
.presale-item__amount {
  font-size: 30rpx;
  color: var(--text);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}
