/* pages/presale/detail.wxss — V2 樱花粉 UI */
.detail-page { padding-bottom: 200rpx; padding-top: 16rpx; }

.detail-hero {
  margin: 0 28rpx 20rpx;
  padding: 40rpx 32rpx;
  border-radius: 28rpx;
  text-align: center;
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(176, 136, 71, 0.35);
}
.detail-hero__name {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 2;
}
.detail-hero__amount {
  font-size: 80rpx;
  color: #fff;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
  position: relative;
  z-index: 2;
}
.detail-hero__status-wrap {
  display: inline-block;
  margin-top: 20rpx;
  position: relative;
  z-index: 2;
}
.detail-hero__status {
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  font-weight: 500;
}
.detail-hero__status--received {
  background: rgba(255, 255, 255, 0.3);
  color: #fff;
}

.section {
  margin: 0 28rpx 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  padding: 8rpx 0;
}
.section__row {
  display: flex;
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid var(--line-soft);
}
.section__row:last-child { border-bottom: 0; }
.section__label { color: var(--text-sub); width: 200rpx; font-size: 26rpx; }
.section__value { flex: 1; color: var(--text); font-size: 26rpx; }

.action-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom, 0px));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-top: 1rpx solid var(--line);
}
.action-bar .btn { flex: 1; }
